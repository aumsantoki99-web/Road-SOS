{
  "expo": {
    "name": "Rescuel",
    "slug": "rescuel",
    "version": "1.0.0",
    "runtimeVersion": "1.0.0",
    "sdkVersion": "54.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#0F172A"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.aumus.roadsos",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "RideSafe uses your location to monitor your ride and find nearby hospitals.",
        "NSLocationAlwaysUsageDescription": "RideSafe uses your location in the background to detect crashes and send emergency alerts.",
        "NSMotionUsageDescription": "RideSafe uses motion sensors to detect potential crashes during your ride.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "config": {
        "googleMapsApiKey": "AIzaSyDfe4gCvQWVgOiPJiYsLmtsf-YPFM3GOwE"
      }
    },
    "android": {
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyDfe4gCvQWVgOiPJiYsLmtsf-YPFM3GOwE"
        }
      },
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/adaptive-icon.png",
        "backgroundColor": "#0F172A"
      },
      "package": "com.aumus.road_sos",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED",
        "FOREGROUND_SERVICE"
      ]
    },
    "web": {
      "favicon": "./src/assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F172A"
        }
      ],
      "expo-font",
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "9b6762b4-e48a-4e27-878a-397461e853ea"
      }
    }
  }
}
