# ─── RoadSOS React App Configuration ───

# Backend server URL (Flask/Python server for SOS calls)
VITE_SERVER_URL=https://your-server-url.com

# Google Maps API Key (optional — app uses Leaflet/OSM by default)
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Emergency contact number for SOS
VITE_EMERGENCY_PHONE=+917359129704

# Target phone number for SOS calls
VITE_TARGET_PHONE=+917359129704
